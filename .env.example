# Password per accedere a /admin (obbligatoria)
ADMIN_PASSWORD=cambia-questa-password

# Facoltativo ma consigliato: storage persistente per il calendario su Vercel.
# Crea un database Upstash Redis gratuito da Vercel Marketplace/Storage
# e incolla qui le due variabili che ti fornisce.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
